{
  "name": "mercadia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MERCADIA \u2014 rival merchant dynasties reshape a sunlit canal-and-tramway city era by era.",
  "scripts": {
    "dev": "wrangler dev --port 8787 --ip 127.0.0.1",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "evidence": "node scripts/evidence.mjs",
    "balance": "npx tsx scripts/balance.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
