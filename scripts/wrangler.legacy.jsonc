{
  // Smoke-only: the production Worker + Durable Object (same class, same migrations, same storage layout)
  // behind scripts/legacy-probe-worker.ts. Never deployed. Run with --persist-to <tmp dir>.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mercadia",
  "main": "legacy-probe-worker.ts",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/__do/*"]
  },
  "durable_objects": { "bindings": [{ "name": "GAME_ROOMS", "class_name": "MercadiaRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MercadiaRoom"] }]
}
